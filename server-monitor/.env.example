# CloudOps Copilot AI configuration example.
# Copy values into your deployment secret or local .env as needed.
# Do not commit real API keys.

# LLM provider.
LLM_API_KEY=
LLM_API_URL=https://api.deepseek.com/v1/chat/completions
LLM_MODEL=deepseek-chat
LLM_TIMEOUT_SECONDS=60
LLM_MAX_TOKENS=2048

# Copilot LLM-assisted routing.
COPILOT_TOOLS_CLASSIFY_ENABLED=true
COPILOT_MULTI_INTENT_ENABLED=true
COPILOT_MULTI_INTENT_MAX=3

# Copilot LLM summary for read-only tool results.
COPILOT_SUMMARY_ENABLED=true
COPILOT_SUMMARY_TIMEOUT_SECONDS=8
COPILOT_SUMMARY_MAX_PROMPT_BYTES=16384
COPILOT_CHAT_HISTORY_MAX_ROUNDS=10

# Runbook reranking.
RERANKER_ENABLED=true
RERANKER_TOP_N=2
RERANKER_TIMEOUT_SECONDS=10

# Embedding and runbook retrieval.
EMBEDDING_API_URL=
EMBEDDING_API_KEY=
EMBEDDING_MODEL=
EMBEDDING_TIMEOUT_SECONDS=10
EMBEDDING_INDEX_BUILD_TIMEOUT_SECONDS=30
EMBEDDING_DIMS=0
RUNBOOK_RRF_K=60

# Diagnosis worker for chat-triggered and event-triggered diagnosis.
DIAGNOSIS_ENABLED=true
DIAGNOSIS_LLM_TIMEOUT_SECONDS=15
