# ============================================
# CloudOps Server Monitor 配置参考
# ============================================
# 使用方式：
#   1. 复制本文件为 .env：cp .env.example .env
#   2. 根据实际环境修改配置值
#   3. 启动服务：docker compose up -d
#
# 说明：
#   - 本文件默认值与 docker-compose.yml 保持一致，复制后可直接启动本地完整栈（K8s 集成除外）
#   - 标记 [敏感] 的配置项包含密钥或密码，不要提交到版本控制
#   - 标记 [Docker] 的配置项在 docker-compose 中已有默认值，本地开发通常无需修改
#   - 未标记的配置项均有合理的默认值，按需覆盖即可
#   - 所有时间类配置单位为秒（除非变量名含 MILLISECONDS/HOURS）
#   - 列表类配置使用英文逗号分隔，如：K8S_ALLOWED_NAMESPACES=default,kube-system
# ============================================


# ============================================
# 一、基础设施 — Redis
# ============================================
# Redis 用于会话缓存、主机列表广播、告警去重、限流计数、诊断任务去重等

# Redis 连接地址，格式 host:port [Docker]
REDIS_ADDR=redis:6379

# Redis 认证密码 [必填] [敏感]
# Docker Compose 默认值：server-monitor-local-redis
# 生产环境务必更换为强密码
REDIS_PASSWORD=server-monitor-local-redis

# Redis 数据库编号，0-15 之间
REDIS_DB=0

# Redis 启动阶段等待连接就绪的超时（秒）
REDIS_STARTUP_TIMEOUT_SECONDS=5

# Redis 拨号连接超时（秒）
REDIS_DIAL_TIMEOUT_SECONDS=5

# Redis 读取操作超时（秒）
REDIS_READ_TIMEOUT_SECONDS=3

# Redis 写入操作超时（秒）
REDIS_WRITE_TIMEOUT_SECONDS=3

# Redis 连接最大存活时间（秒），过期后连接会被关闭重建
REDIS_CONN_MAX_LIFETIME_SECONDS=1800

# Redis 连接最大空闲时间（秒），超过后连接会被回收
REDIS_CONN_MAX_IDLE_TIME_SECONDS=300


# ============================================
# 二、基础设施 — MySQL
# ============================================
# MySQL 用于持久化用户、告警规则、动作审批、反馈等业务数据

# MySQL 主机地址 [Docker]
MYSQL_HOST=mysql

# MySQL 端口
MYSQL_PORT=3306

# MySQL 数据库名 [Docker]
MYSQL_DATABASE=server_monitor

# MySQL 用户名 [Docker]
MYSQL_USER=server_monitor

# MySQL 密码 [必填] [敏感]
# Docker Compose 默认值：server-monitor-local-mysql
# 生产环境务必更换为强密码
MYSQL_PASSWORD=server-monitor-local-mysql

# MySQL root 密码 [敏感]（仅 docker-compose MySQL 容器初始化使用）
# Docker Compose 默认值：server-monitor-local-root
MYSQL_ROOT_PASSWORD=server-monitor-local-root

# MySQL 启动阶段等待连接就绪的超时（秒）
MYSQL_STARTUP_TIMEOUT_SECONDS=5

# MySQL 健康检查超时（秒）
MYSQL_PING_TIMEOUT_SECONDS=3

# MySQL 宿主机映射端口（仅 docker-compose 使用，避免与宿主机 3306 冲突）
MYSQL_HOST_PORT=3306


# ============================================
# 三、基础设施 — Kafka
# ============================================
# Kafka 用于告警事件、操作事件、诊断任务的异步消息传递

# Kafka Broker 地址列表，逗号分隔 [Docker]
KAFKA_BROKERS=kafka:9092

# Kafka 消费者组 ID（alert-service 使用）
KAFKA_GROUP_ID=alert-service


# ============================================
# 四、基础设施 — Grafana
# ============================================
# Grafana 用于监控大盘可视化，以下配置仅 docker-compose 使用

# Grafana 管理员用户名
GRAFANA_ADMIN_USER=admin

# Grafana 管理员密码 [敏感]
# Docker Compose 默认值：server-monitor-local-grafana
GRAFANA_ADMIN_PASSWORD=server-monitor-local-grafana


# ============================================
# 五、鉴权与安全
# ============================================

# 是否启用鉴权，生产环境必须开启
# 设为 false 时所有 API 无需登录即可访问（仅限开发/演示环境）
AUTH_ENABLED=true

# JWT 签名密钥 [必填] [敏感]
# 启用鉴权时必须设置，且不少于 32 字节
# 生产环境务必使用随机强密钥，如：openssl rand -base64 48
# Docker Compose 默认值：server-monitor-local-dev-jwt-secret-change-me
JWT_SECRET=server-monitor-local-dev-jwt-secret-change-me

# JWT 令牌过期时间（小时）
JWT_EXPIRE_HOURS=24

# 初始管理员密码 [敏感]
# 仅在首次启动且数据库中无用户时自动创建 admin 账户
# 留空则不创建初始管理员（需通过其他方式注册）
# Docker Compose 默认值：server-monitor-local-admin
ADMIN_PASSWORD=server-monitor-local-admin

# CORS 允许的跨域来源列表，逗号分隔
# 留空时使用默认策略（同源策略）
# 示例：CORS_ALLOWED_ORIGINS=http://localhost:3000,https://monitor.example.com
CORS_ALLOWED_ORIGINS=

# 受信任的反向代理 IP 列表，逗号分隔
# 留空时不信任任何代理
# 示例：TRUSTED_PROXIES=10.0.0.1,10.0.0.2
TRUSTED_PROXIES=


# ============================================
# 六、限流
# ============================================

# 是否启用 API 限流（基于 Redis 滑动窗口）
# Docker Compose 默认值：true（硬编码覆盖）
RATE_LIMIT_ENABLED=true

# 限流窗口内允许的最大请求数
RATE_LIMIT_REQUESTS=120

# 限流滑动窗口时长（秒）
RATE_LIMIT_WINDOW_SECONDS=60

# 限流 Redis 操作超时（毫秒）
RATE_LIMIT_OPERATION_TIMEOUT_MILLISECONDS=500


# ============================================
# 七、Prometheus 与告警规则
# ============================================

# Prometheus 查询地址 [Docker]
PROMETHEUS_URL=http://prometheus:9090

# Prometheus 热重载地址
# 用于告警规则同步后触发配置重载
# 留空时基于 PROMETHEUS_URL 自动拼接 /-/reload
# Docker Compose 默认值：http://prometheus:9090/-/reload（硬编码覆盖）
PROMETHEUS_RELOAD_URL=http://prometheus:9090/-/reload

# 告警规则文件存储路径
# 为空时禁用规则同步功能
# Docker Compose 默认值：/etc/server-monitor/rules/custom-alerts.yml
ALERT_RULES_FILE_PATH=/etc/server-monitor/rules/custom-alerts.yml

# 是否启用告警规则同步到 Prometheus
ALERT_RULE_SYNC_ENABLED=true

# promtool 可执行文件路径，用于校验告警规则语法
PROMTOOL_PATH=/usr/local/bin/promtool

# 告警规则同步操作超时（秒）
# Docker Compose 默认值：10（硬编码覆盖）
ALERT_RULE_SYNC_TIMEOUT_SECONDS=10

# Prometheus 查询请求超时（秒）
REQUEST_TIMEOUT_SECONDS=5

# 就绪检查中各组件探测超时（秒）
READY_TIMEOUT_SECONDS=3


# ============================================
# 八、LLM 大模型
# ============================================
# LLM 用于 Copilot 对话、工具分类、摘要生成、诊断总结等

# LLM API Key [必填] [敏感]
# 留空时 Copilot 和诊断的 LLM 功能不可用
LLM_API_KEY=

# OpenAI 兼容 Chat Completions 地址
# 支持任何 OpenAI 兼容的 API 端点
LLM_API_URL=https://api.deepseek.com/v1/chat/completions

# LLM 模型名称
LLM_MODEL=deepseek-chat

# LLM 请求超时（秒）
LLM_TIMEOUT_SECONDS=60

# LLM 单次响应最大 token 数
# 值越大响应越详细，但耗时和费用也越高
# Docker Compose 默认值：2048
LLM_MAX_TOKENS=2048


# ============================================
# 九、Copilot 智能助手
# ============================================

# 是否启用 Copilot API
# 关闭后前端聊天入口不可用
COPILOT_ENABLED=true

# 是否启用 Copilot Tool Registry 执行路径
# 关闭后 Copilot 仅走纯 LLM 对话，不调用工具
COPILOT_TOOL_REGISTRY_ENABLED=true

# Copilot 工具默认执行超时（秒）
COPILOT_TOOL_DEFAULT_TIMEOUT_SECONDS=30

# 是否在工具调用日志中记录脱敏后的明文参数
# 开启后便于调试，但可能暴露敏感查询内容
COPILOT_TOOL_LOG_ARGS=false

# 是否启用 LLM 辅助工具分类
# 开启后当规则分类置信度低于阈值时，使用 LLM 进行意图识别
# Docker Compose 默认值：true
COPILOT_TOOLS_CLASSIFY_ENABLED=true

# 规则分类置信度阈值（0-1）
# 低于此值时走 LLM 分类主路径
# 值越高越倾向使用 LLM 分类，值越低越倾向使用规则匹配
COPILOT_LLM_CLASSIFY_THRESHOLD=0.9

# 是否启用多意图识别
# 开启后 Copilot 可以同时识别并执行多个工具调用
# Docker Compose 默认值：true
COPILOT_MULTI_INTENT_ENABLED=true

# 单次多意图识别的最大意图数量（1-5）
COPILOT_MULTI_INTENT_MAX=3

# 是否启用 Copilot 工具结果 LLM 摘要
# 开启后工具返回的原始数据会经过 LLM 生成自然语言摘要
COPILOT_SUMMARY_ENABLED=true

# Copilot 摘要单次 LLM 调用超时（秒）
COPILOT_SUMMARY_TIMEOUT_SECONDS=8

# Copilot 摘要 prompt 最大字节数
# 超过此大小的工具结果会被截断后再送入 LLM
COPILOT_SUMMARY_MAX_PROMPT_BYTES=16384

# Copilot 传给 LLM 的历史对话轮数
# 值越大上下文越完整，但 token 消耗也越多
COPILOT_CHAT_HISTORY_MAX_ROUNDS=10

# Copilot Redis 会话 TTL（秒）
# 超过此时间的空闲会话会被清理
COPILOT_SESSION_TTL_SECONDS=7200

# Copilot 单条消息最大字符数
COPILOT_MAX_MESSAGE_LENGTH=2000

# Copilot 单会话保留消息数
COPILOT_MAX_SESSION_MESSAGES=50


# ============================================
# 十、Runbook 知识库与 Embedding
# ============================================
# Runbook 是运维知识库（Markdown 格式），用于诊断时提供参考建议
# Embedding 用于 Runbook 的语义检索

# Runbook Markdown 文件目录
# 为空时禁用 Runbook 检索功能
# Docker Compose 默认值：/app/runbooks
RUNBOOK_DIR=/app/runbooks

# 最大 Runbook 文件数量
RUNBOOK_MAX_FILES=100

# 单个 Runbook Markdown 最大字节数
RUNBOOK_MAX_FILE_BYTES=65536

# 诊断默认注入的 Runbook 片段数量（1-5）
RUNBOOK_SEARCH_TOP_N=2

# BM25 文本检索权重（0-1），剩余权重给向量检索
# 0 = 纯向量检索，1 = 纯 BM25 检索
RUNBOOK_BM25_WEIGHT=0.3

# BM25 算法 k1 参数，控制词频饱和度
RUNBOOK_BM25_K1=1.2

# BM25 算法 b 参数，控制文档长度归一化
RUNBOOK_BM25_B=0.75

# RRF（Reciprocal Rank Fusion）常数 K
# 用于融合 BM25 和向量检索的排序结果
RUNBOOK_RRF_K=60

# Embedding API 地址
# 支持 OpenAI 兼容的 Embedding API
# 留空时 Runbook 仅使用 BM25 文本检索，不使用语义检索
EMBEDDING_API_URL=

# Embedding API Key [敏感]
EMBEDDING_API_KEY=

# Embedding 模型名称
EMBEDDING_MODEL=

# Embedding 单次请求超时（秒）
EMBEDDING_TIMEOUT_SECONDS=10

# Embedding 索引构建超时（秒）
# 服务启动时构建 Runbook 向量索引的最大等待时间
EMBEDDING_INDEX_BUILD_TIMEOUT_SECONDS=30

# Embedding 向量维度
# 必须与所选模型输出维度一致
# 设为 0 时自动从首次 API 响应推断
EMBEDDING_DIMS=0


# ============================================
# 十一、Reranker 重排序
# ============================================
# Reranker 对 Runbook 检索结果进行二次排序，提升相关性

# 是否启用 Reranker
# 需要配置 EMBEDDING_API_URL 指向支持 Rerank 的 API
# Docker Compose 默认值：true
RERANKER_ENABLED=true

# Reranker 返回的 Top N 结果数（1-5）
RERANKER_TOP_N=2

# Reranker 请求超时（秒）
RERANKER_TIMEOUT_SECONDS=10


# ============================================
# 十二、告警自动诊断
# ============================================
# 诊断 Worker 消费 Kafka 告警事件，自动调用工具和 LLM 生成诊断报告

# 是否启用告警自动诊断 Worker
# 启用时要求：COPILOT_ENABLED=true、KAFKA_BROKERS 非空、REDIS_ADDR 非空
# Docker Compose 默认值：true
DIAGNOSIS_ENABLED=true

# 诊断总结 LLM 请求超时（秒）
DIAGNOSIS_LLM_TIMEOUT_SECONDS=15

# 自动诊断 Worker 并发数量（1-8）
DIAGNOSIS_WORKER_COUNT=1

# 自动诊断 Kafka Consumer Group ID
DIAGNOSIS_KAFKA_GROUP_ID=diagnosis-worker

# 自动诊断 Redis 去重任务 TTL（秒）
# 同一告警在此时间内不会重复诊断
DIAGNOSIS_TASK_TTL_SECONDS=1800

# 单次自动诊断总超时（秒）
# 必须大于 DIAGNOSIS_LLM_TIMEOUT_SECONDS
DIAGNOSIS_TASK_TIMEOUT_SECONDS=120

# 临时错误是否不提交 Kafka offset（允许重试）
DIAGNOSIS_RETRYABLE_ERRORS=true

# 是否推送 diagnosis_update WebSocket 消息
DIAGNOSIS_STATUS_PUSH_ENABLED=true


# ============================================
# 十三、动作审批与执行
# ============================================
# 动作系统允许 Copilot 建议运维操作（如扩缩容），经审批后执行

# 是否启用动作审批 API
ACTION_APPROVAL_ENABLED=true

# 是否允许真实执行白名单动作
# 关闭时动作仅停留在建议阶段，不会实际执行
# 生产环境建议先关闭，确认流程后再开启
ACTION_EXECUTION_ENABLED=false

# scale_deployment 允许的最大副本数（1-100）
ACTION_MAX_REPLICAS=10

# 待审批动作建议过期时间（小时，1-168）
ACTION_PENDING_TTL_HOURS=24

# 是否发布 operation-events 到 Kafka
ACTION_OPERATION_EVENTS_ENABLED=true

# 是否推送 action 状态 WebSocket 消息
ACTION_STATUS_PUSH_ENABLED=true


# ============================================
# 十四、反馈
# ============================================

# 是否启用用户反馈功能
FEEDBACK_ENABLED=true

# 反馈评论最大长度（100-2000）
FEEDBACK_COMMENT_MAX_LENGTH=500


# ============================================
# 十五、Kubernetes 集成
# ============================================
# K8s 集成提供 Pod/Deployment/Service/Event/Log 等只读查询和写操作

# 是否启用 K8s 只读工具和诊断证据采集
# 默认保持关闭；需先执行 make k8s-setup 或 docker/setup-k8s.sh 生成 kubeconfig 后再开启
K8S_ENABLED=false

# 是否启用审批后的真实 K8s 写操作
# 启用要求：K8S_ENABLED=true、ACTION_APPROVAL_ENABLED=true、ACTION_EXECUTION_ENABLED=true
K8S_WRITE_ENABLED=false

# 是否启用集群级 Node 查询工具
# 启用要求：K8S_ENABLED=true
K8S_NODES_ENABLED=false

# 是否启用 K8s HTTP API 和前端页面（独立于 Copilot K8s 工具）
# 设为 false 时，Copilot K8s 工具仍可用（需 K8S_ENABLED=true），但前端 K8s 页面和 REST API 不可访问
# 默认值：false（需显式开启，避免扩大读权限范围）
K8S_API_ENABLED=false

# 是否优先使用集群内 ServiceAccount 配置
# true：运行在 K8s Pod 内时使用 ServiceAccount
# false：使用 K8S_KUBECONFIG 指定的 kubeconfig 文件
# Docker Compose 默认值：false
K8S_IN_CLUSTER=false

# 本地或 Compose 模式使用的 kubeconfig 文件路径
# 仅在 K8S_IN_CLUSTER=false 时生效
# Docker Compose 默认值：/opt/server-monitor/docker/kubeconfig
#   由 docker-compose.yml 挂载 ./docker 目录，并通过 host.docker.internal 访问本机 kind API Server
K8S_KUBECONFIG=/opt/server-monitor/docker/kubeconfig

# 允许访问的 K8s namespace 列表，逗号分隔
# K8S_DEFAULT_NAMESPACE 必须包含在此列表中
K8S_ALLOWED_NAMESPACES=default

# 未指定 namespace 时使用的默认 namespace
K8S_DEFAULT_NAMESPACE=default

# 单次 K8s API 调用超时（秒，1-60）
K8S_REQUEST_TIMEOUT_SECONDS=10

# k8s.get_logs 默认日志行数（1-1000）
K8S_LOG_TAIL_LINES=100

# k8s.get_logs 单次最大返回字节数（1024-262144）
K8S_LOG_MAX_BYTES=32768

# k8s.get_events 默认返回条数（1-200）
K8S_EVENT_LIMIT=50

# K8s 资源缓存 TTL（秒），适用于 Overview 等单资源查询
K8S_CACHE_TTL_SECONDS=30

# K8s 列表资源缓存 TTL（秒），适用于 ListNodes/ListPods 等列表查询
K8S_LIST_CACHE_TTL_SECONDS=15

# K8s Event WebSocket 推送轮询间隔（秒）
K8S_EVENT_WATCH_INTERVAL_SECONDS=5

# 多集群配置，JSON 数组格式
# 每个集群包含：name, kubeconfig, in_cluster, allowed_namespaces, default_namespace, request_timeout
# 示例：
# K8S_CLUSTERS=[{"name":"staging","kubeconfig":"/app/kubeconfig-staging","in_cluster":false,"allowed_namespaces":["default","staging"],"default_namespace":"staging","request_timeout":"10s"},{"name":"production","in_cluster":true,"allowed_namespaces":["default","production"],"default_namespace":"production","request_timeout":"15s"}]
# 留空时使用单集群模式（K8S_IN_CLUSTER/K8S_KUBECONFIG 配置）
K8S_CLUSTERS=


# ============================================
# 十六、Phase 3 只读变更智能（默认关闭）
# ============================================
CHANGE_INTELLIGENCE_ENABLED=false
CHANGE_LOOKBACK=86400
CHANGE_MAX_CANDIDATES=10
# JSON key 为 Incident service_name；仅声明固定 Repository/Application/GitOps 路径。
CHANGE_SERVICE_MAPPINGS_JSON={}

GITHUB_ENABLED=false
GITHUB_API_BASE_URL=https://api.github.com
GITHUB_APP_ID=0
GITHUB_INSTALLATION_ID=0
# 二选一：GitHub App 私钥文件，或只读 token 文件。不得把 token 明文放入本文件。
GITHUB_PRIVATE_KEY_FILE=
GITHUB_TOKEN_FILE=
GITHUB_ALLOWED_OWNERS=
GITHUB_ALLOWED_REPOSITORIES=
GITHUB_ALLOWED_BRANCHES=
GITHUB_ALLOWED_PATHS=
GITHUB_DENIED_PATH_PATTERNS=.env,*.pem,*secret*,*credential*
GITHUB_MAX_DIFF_FILES=100
GITHUB_MAX_DIFF_BYTES=131072
GITHUB_TIMEOUT=10
GITHUB_MAX_RETRIES=1

ARGOCD_ENABLED=false
ARGOCD_SERVER=
# 仅接受挂载文件；不得把 Bearer token 明文放入本文件。
ARGOCD_TOKEN_FILE=
ARGOCD_ALLOWED_APPLICATIONS=
ARGOCD_ALLOWED_PROJECTS=
ARGOCD_TIMEOUT=10
ARGOCD_MAX_RESOURCES=100
ARGOCD_MAX_DIFF_BYTES=131072

IMAGE_REVISION_REQUIRED=false
IMAGE_ALLOWED_REGISTRIES=

# Registry/OCI metadata reader is a fixed-host, immutable-digest, GET-only path.
# Credentials are file references under an operator-provided read-only mount; never put values here.
REGISTRY_METADATA_ENABLED=false
REGISTRY_BASE_URL=
REGISTRY_ALLOWED_HOSTS=
REGISTRY_ALLOWED_REPOSITORIES=
REGISTRY_ALLOWED_AUTH_REALM_HOSTS=
REGISTRY_ALLOWED_REDIRECT_HOSTS=
OCI_ALLOWED_SOURCE_REPOSITORIES=
REGISTRY_BEARER_TOKEN_FILE=
REGISTRY_USERNAME_FILE=
REGISTRY_PASSWORD_FILE=
REGISTRY_TIMEOUT=10
REGISTRY_MAX_RETRIES=1
REGISTRY_MANIFEST_MAX_BYTES=4194304
REGISTRY_CONFIG_MAX_BYTES=1048576
REGISTRY_CACHE_TTL_SECONDS=300
REGISTRY_CACHE_MAX_ITEMS=256

# ============================================
# 十七、Phase 4 人工审批 GitOps Draft PR（全部默认关闭）
# ============================================
REMEDIATION_ENABLED=false
GITOPS_PR_ENABLED=false
GITHUB_WRITE_ENABLED=false
REMEDIATION_ALLOWED_OPERATIONS=rollback_image,set_replicas
REMEDIATION_MAX_PATCH_BYTES=16384
REMEDIATION_MAX_FILES=1
REMEDIATION_MAX_RISK=medium
REMEDIATION_MIN_REPLICAS=1
REMEDIATION_MAX_REPLICAS=20
REMEDIATION_HPA_TARGETS=
GITOPS_BASE_BRANCHES_JSON={}
GITHUB_WRITE_API_BASE_URL=https://api.github.com
GITHUB_WRITE_APP_ID=0
GITHUB_WRITE_INSTALLATION_ID=0
# Write credential mount must be distinct from the Phase 3 read credential mount.
GITHUB_WRITE_PRIVATE_KEY_FILE=
GITHUB_WRITE_TOKEN_FILE=
GITHUB_WRITE_ALLOWED_REPOSITORIES=
GITHUB_WRITE_ALLOWED_BASE_BRANCHES=
GITHUB_WRITE_ALLOWED_PATHS=
GITHUB_WRITE_TIMEOUT_SECONDS=10
GITHUB_WRITE_MAX_RESPONSE_BYTES=1048576
GITHUB_WRITE_MAX_CONTENT_BYTES=131072
REMEDIATION_WORKER_ID=server-web-remediation-worker
REMEDIATION_POLL_INTERVAL_MILLISECONDS=1000
REMEDIATION_LEASE_SECONDS=30


# ============================================
# 十八、HTTP 服务器（server-web）
# ============================================
# 以下配置通常无需修改，除非有特殊的网络环境需求

# HTTP 监听地址，格式 host:port
LISTEN_ADDR=:8080

# HTTP 读取请求头超时（秒）
HTTP_READ_HEADER_TIMEOUT_SECONDS=5

# HTTP 读取请求体超时（秒）
HTTP_READ_TIMEOUT_SECONDS=15

# HTTP 写入响应超时（秒）
HTTP_WRITE_TIMEOUT_SECONDS=30

# HTTP 长连接空闲超时（秒）
HTTP_IDLE_TIMEOUT_SECONDS=120

# 优雅关闭总超时（秒）
SHUTDOWN_TIMEOUT_SECONDS=5

# Gin 框架运行模式：debug / release / test
# Docker Compose 默认值：release（硬编码覆盖）
GIN_MODE=release

# 前端静态文件目录
# 为空时不提供静态文件服务（由独立前端服务提供）
# Docker Compose 默认值：/app/static
STATIC_DIR=/app/static

# WebSocket 最大并发连接数
WS_MAX_CONNECTIONS=1000


# ============================================
# 十七、缓存与广播
# ============================================

# 主机列表 WebSocket 广播间隔（秒）
HOSTS_BROADCAST_INTERVAL_SECONDS=5

# 主机列表缓存 TTL（秒）
HOSTS_CACHE_TTL_SECONDS=30

# 仪表盘概览缓存 TTL（秒）
DASHBOARD_OVERVIEW_TTL_SECONDS=10

# 告警事件去重窗口 TTL（秒），默认 24 小时
ALERT_EVENT_DEDUPE_TTL_SECONDS=86400

# Alertmanager Webhook 请求体最大字节数
ALERTMANAGER_WEBHOOK_MAX_BODY_BYTES=1048576

# V2 Incident 确定性告警聚合窗口（秒），默认 4 小时
INCIDENT_AGGREGATION_WINDOW_SECONDS=14400

# 缓存写入操作超时（秒）
CACHE_WRITE_TIMEOUT_SECONDS=3


# ============================================
# 十八、server-probe 监控探针
# ============================================
# 以下配置仅影响 server-probe 服务

# Prometheus 指标暴露路径，必须以 / 开头
METRICS_PATH=/metrics

# 指标采集间隔（秒）
SCRAPE_INTERVAL=5

# Prometheus HTTP Handler 最大并发请求数
PROMHTTP_MAX_REQUESTS_IN_FLIGHT=5

# Prometheus HTTP Handler 单请求超时（秒）
PROMHTTP_TIMEOUT=5

# server-probe HTTP 读取请求体超时（秒）
HTTP_READ_TIMEOUT=10

# server-probe HTTP 写入响应超时（秒）
HTTP_WRITE_TIMEOUT=10

# server-probe HTTP 长连接空闲超时（秒）
HTTP_IDLE_TIMEOUT=60

# server-probe 优雅关闭超时（秒）
SHUTDOWN_TIMEOUT=5

# 探针标识的主机名，用于指标标签
# 留空时自动获取系统主机名
HOSTNAME=

# 宿主机 /proc 文件系统挂载路径
# Docker 部署时需挂载宿主机 /proc 到容器内，并设置此路径
# 留空时使用本机 /proc
HOST_PROC=/host/proc

# 宿主机 /sys 文件系统挂载路径
# Docker 部署时需挂载宿主机 /sys 到容器内，并设置此路径
# 留空时使用本机 /sys
HOST_SYS=/host/sys


# ============================================
# 十九、可观测性
# ============================================

# 日志级别：debug / info / warn / error
LOG_LEVEL=info

# OpenTelemetry OTLP gRPC 导出端点，格式 host:port
# 留空时禁用链路追踪
# Docker Compose 默认值：jaeger:4317（硬编码覆盖）
TRACE_OTLP_ENDPOINT=jaeger:4317

# 链路追踪采样率（0-1）
# 1.0 = 全量采样，0.1 = 10% 采样，0 = 不采样
TRACE_SAMPLE_RATE=1.0

# 实例标识，用于日志和链路追踪中的实例区分
# 留空时使用 HOSTNAME 环境变量
INSTANCE=


# ============================================
# 二十、Docker 日志采集
# ============================================
# 以下配置仅影响 docker-compose 中的 Fluent Bit 服务

# Docker 容器日志路径
# macOS Docker Desktop 可能需要：~/.docker/containers
DOCKER_CONTAINER_LOG_PATH=/var/lib/docker/containers
