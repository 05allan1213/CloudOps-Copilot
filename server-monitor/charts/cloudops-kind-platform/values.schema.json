{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": ["image", "database", "persistence", "resources", "observability"],
  "properties": {
    "image": {
      "type": "object",
      "required": ["repository", "tag", "digest", "pullPolicy"],
      "properties": {
        "repository": {"type": "string", "minLength": 1},
        "tag": {"type": "string", "minLength": 1},
        "digest": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"},
        "pullPolicy": {"type": "string", "enum": ["Always", "IfNotPresent", "Never"]}
      }
    },
    "database": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "root", "identities"],
      "properties": {
        "name": {"type": "string", "pattern": "^[a-zA-Z0-9_]+$"},
        "root": {
          "type": "object",
          "additionalProperties": false,
          "required": ["secretName", "passwordKey"],
          "properties": {
            "secretName": {"type": "string", "minLength": 1},
            "passwordKey": {"type": "string", "minLength": 1}
          }
        },
        "identities": {
          "type": "object",
          "additionalProperties": false,
          "required": ["api", "worker", "migrate", "baseline"],
          "properties": {
            "api": {"$ref": "#/definitions/mysqlIdentity"},
            "worker": {"$ref": "#/definitions/mysqlIdentity"},
            "migrate": {"$ref": "#/definitions/mysqlIdentity"},
            "baseline": {"$ref": "#/definitions/mysqlIdentity"}
          }
        }
      }
    },
    "observability": {
      "type": "object",
      "required": ["enabled", "environment", "clusterName", "namespaces", "elastic", "otelCollector", "tempo"],
      "properties": {
        "enabled": {"type": "boolean"},
        "environment": {"type": "string", "minLength": 1},
        "clusterName": {"type": "string", "minLength": 1},
        "namespaces": {
          "type": "object",
          "required": ["cloudops", "demo"],
          "properties": {
            "cloudops": {"type": "string", "pattern": "^[a-z0-9]([-a-z0-9]*[a-z0-9])?$"},
            "demo": {"type": "string", "pattern": "^[a-z0-9]([-a-z0-9]*[a-z0-9])?$"}
          }
        },
        "elastic": {
          "type": "object",
          "required": ["version", "elasticsearch", "kibana", "filebeat"],
          "properties": {
            "version": {"type": "string", "pattern": "^[89]\\.[0-9]+\\.[0-9]+$"},
            "elasticsearch": {
              "allOf": [
                {"$ref": "#/definitions/elasticWorkload"},
                {
                  "type": "object",
                  "required": ["readRoleSecretName", "storage", "javaOpts"],
                  "properties": {
                    "readRoleSecretName": {"type": "string", "minLength": 1},
                    "javaOpts": {"type": "string", "minLength": 1},
                    "storage": {
                      "type": "object",
                      "required": ["size"],
                      "properties": {
                        "size": {"type": "string", "minLength": 1},
                        "storageClassName": {"type": "string"}
                      }
                    }
                  }
                }
              ]
            },
            "kibana": {"$ref": "#/definitions/elasticWorkload"},
            "filebeat": {
              "allOf": [
                {"$ref": "#/definitions/elasticWorkload"},
                {
                  "type": "object",
                  "required": ["dataStream", "serviceAccountName", "registryHostPath"],
                  "properties": {
                    "dataStream": {"type": "string", "minLength": 1},
                    "serviceAccountName": {"type": "string", "minLength": 1},
                    "registryHostPath": {"type": "string", "pattern": "^/"},
                    "queueEvents": {"type": "integer", "minimum": 1},
                    "flushMinEvents": {"type": "integer", "minimum": 1},
                    "flushTimeout": {"type": "string", "minLength": 1}
                  }
                }
              ]
            }
          }
        },
        "otelCollector": {
          "allOf": [
            {"$ref": "#/definitions/collector"},
            {
              "type": "object",
              "required": ["memoryLimitMiB", "memorySpikeLimitMiB"],
              "properties": {
                "memoryLimitMiB": {"type": "integer", "minimum": 1},
                "memorySpikeLimitMiB": {"type": "integer", "minimum": 1}
              }
            }
          ]
        },
        "tempo": {
          "allOf": [
            {"$ref": "#/definitions/collector"},
            {
              "type": "object",
              "required": ["target", "retention", "storage"],
              "properties": {
                "target": {"const": "all"},
                "retention": {"type": "string", "minLength": 1},
                "storage": {
                  "type": "object",
                  "required": ["size"],
                  "properties": {
                    "size": {"type": "string", "minLength": 1},
                    "storageClassName": {"type": "string"}
                  }
                }
              }
            }
          ]
        }
      }
    }
  },
  "definitions": {
    "mysqlIdentity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["user", "secretName", "passwordKey"],
      "properties": {
        "user": {"type": "string", "pattern": "^[A-Za-z0-9_][A-Za-z0-9_-]{0,31}$"},
        "secretName": {"type": "string", "minLength": 1},
        "passwordKey": {"type": "string", "minLength": 1}
      }
    },
    "image": {
      "type": "object",
      "required": ["repository", "tag", "digest", "pullPolicy"],
      "properties": {
        "repository": {"type": "string", "minLength": 1},
        "tag": {"type": "string", "pattern": "^[^:]+$"},
        "digest": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"},
        "pullPolicy": {"type": "string", "enum": ["Always", "IfNotPresent", "Never"]}
      }
    },
    "elasticWorkload": {
      "type": "object",
      "required": ["name", "image", "resources"],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "image": {"$ref": "#/definitions/image"},
        "resources": {"type": "object"}
      }
    },
    "collector": {
      "type": "object",
      "required": ["name", "serviceAccountName", "image", "resources"],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "serviceAccountName": {"type": "string", "minLength": 1},
        "image": {"$ref": "#/definitions/image"},
        "resources": {"type": "object"}
      }
    }
  }
}
