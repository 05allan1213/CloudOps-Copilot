{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": ["image", "replicaCount", "clusterName", "environment", "requiredEnv", "sourceRevision", "trace", "monitoring", "loadGenerator", "resources", "loadGeneratorResources"],
  "properties": {
    "image": { "$ref": "#/definitions/runtimeImage" },
    "replicaCount": { "type": "integer", "const": 2 },
    "clusterName": { "type": "string", "minLength": 1, "maxLength": 63 },
    "environment": { "type": "string", "minLength": 1, "maxLength": 63 },
    "requiredEnv": { "type": "string", "minLength": 1, "maxLength": 128 },
    "sourceRevision": { "type": "string", "pattern": "^(unknown|[a-f0-9]{40})$" },
    "trace": {
      "type": "object",
      "required": ["otlpEndpoint", "sampleRate"],
      "properties": {
        "otlpEndpoint": { "type": "string" },
        "sampleRate": { "type": "string", "const": "1" }
      }
    },
    "monitoring": {
      "type": "object",
      "required": ["interval", "scrapeTimeout", "readinessAlertFor", "errorAlertFor", "errorRateThreshold"],
      "properties": {
        "interval": { "type": "string", "pattern": "^[1-9][0-9]*(ms|s|m)$" },
        "scrapeTimeout": { "type": "string", "pattern": "^[1-9][0-9]*(ms|s|m)$" },
        "readinessAlertFor": { "type": "string", "pattern": "^[1-9][0-9]*(s|m)$" },
        "errorAlertFor": { "type": "string", "pattern": "^[1-9][0-9]*(s|m)$" },
        "errorRateThreshold": { "type": "number", "minimum": 0.01, "maximum": 1 }
      }
    },
    "loadGenerator": {
      "type": "object",
      "required": ["enabled", "ratePerSecond", "requestTimeoutSeconds", "maxDurationSeconds"],
      "properties": {
        "enabled": { "type": "boolean", "const": true },
        "ratePerSecond": { "type": "integer", "const": 5 },
        "requestTimeoutSeconds": { "type": "integer", "const": 2 },
        "maxDurationSeconds": { "type": "integer", "minimum": 1, "maximum": 1800 }
      }
    }
  },
  "definitions": {
    "runtimeImage": {
      "type": "object",
      "required": ["repository", "tag", "digest", "pullPolicy"],
      "properties": {
        "repository": { "type": "string", "minLength": 1 },
        "tag": { "type": "string", "minLength": 1 },
        "digest": { "type": "string", "pattern": "^(|sha256:[a-f0-9]{64})$" },
        "pullPolicy": { "type": "string", "enum": ["Always", "IfNotPresent", "Never"] }
      }
    }
  }
}
