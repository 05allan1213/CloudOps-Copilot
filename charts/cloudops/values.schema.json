{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "profile",
    "images",
    "commonEnv",
    "database",
    "webhook",
    "csrf",
    "api",
    "migrate",
    "oauth",
    "worker",
    "baselineVerifier",
    "observability"
  ],
  "properties": {
    "profile": {
      "type": "string",
      "enum": ["phase3", "phase4", "phase5", "phase6"]
    },
    "images": {
      "type": "object",
      "additionalProperties": false,
      "required": ["api", "worker", "migrate", "oauth2Proxy"],
      "properties": {
        "api": { "$ref": "#/definitions/runtimeImage" },
        "worker": { "$ref": "#/definitions/runtimeImage" },
        "migrate": { "$ref": "#/definitions/runtimeImage" },
        "oauth2Proxy": {
          "allOf": [
            { "$ref": "#/definitions/runtimeImage" },
            {
              "type": "object",
              "properties": {
                "tag": { "type": "string", "enum": ["v7.15.3"] }
              }
            }
          ]
        }
      }
    },
    "commonEnv": { "$ref": "#/definitions/envMap" },
    "database": {
      "type": "object",
      "additionalProperties": false,
      "required": ["secretName", "passwordKey"],
      "properties": {
        "secretName": { "$ref": "#/definitions/nonEmptyString" },
        "passwordKey": { "$ref": "#/definitions/nonEmptyString" }
      }
    },
    "webhook": {
      "type": "object",
      "additionalProperties": false,
      "required": ["secretName", "secretKey", "mountPath", "tokenFile"],
      "properties": {
        "secretName": { "$ref": "#/definitions/nonEmptyString" },
        "secretKey": { "$ref": "#/definitions/nonEmptyString" },
        "mountPath": { "$ref": "#/definitions/absolutePath" },
        "tokenFile": { "$ref": "#/definitions/absolutePath" }
      }
    },
    "csrf": {
      "type": "object",
      "additionalProperties": false,
      "required": ["secretName", "secretKey", "mountPath", "secretFile"],
      "properties": {
        "secretName": { "$ref": "#/definitions/nonEmptyString" },
        "secretKey": { "$ref": "#/definitions/nonEmptyString" },
        "mountPath": { "$ref": "#/definitions/absolutePath" },
        "secretFile": { "$ref": "#/definitions/absolutePath" }
      }
    },
    "api": {
      "type": "object",
      "additionalProperties": false,
      "required": ["enabled", "replicas", "userPort", "internalPort", "env", "resources"],
      "properties": {
        "enabled": { "type": "boolean" },
        "replicas": { "type": "integer", "minimum": 1, "maximum": 5 },
        "userPort": { "type": "integer", "enum": [8080] },
        "internalPort": { "type": "integer", "enum": [8082] },
        "env": { "$ref": "#/definitions/envMap" },
        "resources": { "$ref": "#/definitions/resources" }
      }
    },
    "migrate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["enabled", "backoffLimit", "activeDeadlineSeconds", "ttlSecondsAfterFinished", "resources"],
      "properties": {
        "enabled": { "type": "boolean" },
        "backoffLimit": { "type": "integer", "minimum": 0, "maximum": 10 },
        "activeDeadlineSeconds": { "type": "integer", "minimum": 30, "maximum": 900 },
        "ttlSecondsAfterFinished": { "type": "integer", "minimum": 0 },
        "resources": { "$ref": "#/definitions/resources" }
      }
    },
    "oauth": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "enabled",
        "port",
        "metricsPort",
        "redirectURL",
        "allowedEmailDomains",
        "viewerLogins",
        "operatorLogins",
        "secret",
        "cookie",
        "resources"
      ],
      "properties": {
        "enabled": { "type": "boolean" },
        "port": { "type": "integer", "enum": [4180] },
        "metricsPort": { "type": "integer", "enum": [44180] },
        "redirectURL": { "type": "string", "pattern": "^https?://[^[:space:]]+/oauth2/callback$" },
        "allowedEmailDomains": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/definitions/nonEmptyString" }
        },
        "viewerLogins": { "$ref": "#/definitions/githubLogins" },
        "operatorLogins": { "$ref": "#/definitions/githubLogins" },
        "secret": {
          "type": "object",
          "additionalProperties": false,
          "required": ["name", "clientIDKey", "clientSecretKey", "cookieSecretKey"],
          "properties": {
            "name": { "$ref": "#/definitions/nonEmptyString" },
            "clientIDKey": { "$ref": "#/definitions/nonEmptyString" },
            "clientSecretKey": { "$ref": "#/definitions/nonEmptyString" },
            "cookieSecretKey": { "$ref": "#/definitions/nonEmptyString" }
          }
        },
        "cookie": {
          "type": "object",
          "additionalProperties": false,
          "required": ["name", "secure", "sameSite", "expire", "refresh"],
          "properties": {
            "name": { "type": "string", "pattern": "^_[A-Za-z0-9_]+$" },
            "secure": { "type": "boolean" },
            "sameSite": { "type": "string", "enum": ["lax", "strict", "none"] },
            "expire": { "$ref": "#/definitions/duration" },
            "refresh": { "$ref": "#/definitions/nonNegativeDuration" }
          }
        },
        "resources": { "$ref": "#/definitions/resources" }
      }
    },
    "worker": {
      "type": "object",
      "additionalProperties": false,
      "required": ["enabled", "replicas", "managementPort", "demoNamespace", "providerConfigSecretName", "credentials", "env", "resources"],
      "properties": {
        "enabled": { "type": "boolean" },
        "replicas": { "type": "integer", "minimum": 1, "maximum": 5 },
        "managementPort": { "type": "integer", "enum": [8081] },
        "demoNamespace": { "type": "string", "pattern": "^[a-z0-9]([-a-z0-9]*[a-z0-9])?$" },
        "providerConfigSecretName": { "$ref": "#/definitions/nonEmptyString" },
        "credentials": {
          "type": "object",
          "additionalProperties": false,
          "required": ["secretName", "mountPath", "files"],
          "properties": {
            "secretName": { "$ref": "#/definitions/nonEmptyString" },
            "mountPath": { "$ref": "#/definitions/absolutePath" },
            "files": {
              "type": "object",
              "minProperties": 1,
              "propertyNames": { "pattern": "^[A-Z_][A-Z0-9_]*_FILE$" },
              "additionalProperties": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$" }
            }
          }
        },
        "env": { "$ref": "#/definitions/envMap" },
        "resources": { "$ref": "#/definitions/resources" }
      }
    },
    "baselineVerifier": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "enabled",
        "demoNamespace",
        "backoffLimit",
        "activeDeadlineSeconds",
        "ttlSecondsAfterFinished",
        "database",
        "credentials",
        "env",
        "resources"
      ],
      "properties": {
        "enabled": { "type": "boolean" },
        "demoNamespace": { "type": "string", "pattern": "^[a-z0-9]([-a-z0-9]*[a-z0-9])?$" },
        "backoffLimit": { "type": "integer", "minimum": 0, "maximum": 5 },
        "activeDeadlineSeconds": { "type": "integer", "minimum": 30, "maximum": 600 },
        "ttlSecondsAfterFinished": { "type": "integer", "minimum": 0 },
        "database": {
          "type": "object",
          "additionalProperties": false,
          "required": ["user", "secretName", "passwordKey"],
          "properties": {
            "user": { "$ref": "#/definitions/nonEmptyString" },
            "secretName": { "$ref": "#/definitions/nonEmptyString" },
            "passwordKey": { "$ref": "#/definitions/nonEmptyString" }
          }
        },
        "credentials": {
          "type": "object",
          "additionalProperties": false,
          "required": ["secretName", "mountPath", "files"],
          "properties": {
            "secretName": { "$ref": "#/definitions/nonEmptyString" },
            "mountPath": { "$ref": "#/definitions/absolutePath" },
            "files": {
              "type": "object",
              "minProperties": 1,
              "propertyNames": { "pattern": "^[A-Z_][A-Z0-9_]*_FILE$" },
              "additionalProperties": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$" }
            }
          }
        },
        "env": { "$ref": "#/definitions/envMap" },
        "resources": { "$ref": "#/definitions/resources" }
      }
    },
    "observability": {
      "type": "object",
      "additionalProperties": false,
      "required": ["enabled", "serviceMonitor"],
      "properties": {
        "enabled": { "type": "boolean" },
        "serviceMonitor": {
          "type": "object",
          "additionalProperties": false,
          "required": ["interval", "scrapeTimeout"],
          "properties": {
            "interval": { "$ref": "#/definitions/duration" },
            "scrapeTimeout": { "$ref": "#/definitions/duration" }
          }
        }
      }
    }
  },
  "definitions": {
    "nonEmptyString": { "type": "string", "minLength": 1 },
    "absolutePath": { "type": "string", "pattern": "^/" },
    "duration": { "type": "string", "pattern": "^[1-9][0-9]*(ms|s|m|h)$" },
    "nonNegativeDuration": { "type": "string", "pattern": "^(0|[1-9][0-9]*)(ms|s|m|h)$" },
    "githubLogins": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[A-Za-z0-9]([A-Za-z0-9-]{0,37}[A-Za-z0-9])?$"
      }
    },
    "envMap": {
      "type": "object",
      "propertyNames": { "pattern": "^[A-Z_][A-Z0-9_]*$" },
      "additionalProperties": { "type": ["string", "number", "boolean"] }
    },
    "runtimeImage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository", "tag", "digest", "pullPolicy"],
      "properties": {
        "repository": { "$ref": "#/definitions/nonEmptyString" },
        "tag": { "$ref": "#/definitions/nonEmptyString" },
        "digest": { "type": "string", "pattern": "^(|sha256:[a-f0-9]{64})$" },
        "pullPolicy": { "type": "string", "enum": ["Always", "IfNotPresent", "Never"] }
      }
    },
    "resources": {
      "type": "object",
      "additionalProperties": false,
      "required": ["requests", "limits"],
      "properties": {
        "requests": { "$ref": "#/definitions/resourceList" },
        "limits": { "$ref": "#/definitions/resourceList" }
      }
    },
    "resourceList": {
      "type": "object",
      "additionalProperties": false,
      "required": ["cpu", "memory"],
      "properties": {
        "cpu": { "$ref": "#/definitions/nonEmptyString" },
        "memory": { "$ref": "#/definitions/nonEmptyString" }
      }
    }
  }
}
