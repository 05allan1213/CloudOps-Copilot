{
  "name": "cloudops-workbench",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit && vite build",
    "bundle:check": "node scripts/check-bundle-budget.mjs",
    "preview": "vite preview",
    "lint": "eslint . --ext .ts,.vue",
    "lint:no-new-warnings": "eslint . --ext .ts,.vue --max-warnings 2564",
    "typecheck": "vue-tsc --noEmit",
    "typecheck:e2e": "tsc -p tsconfig.e2e.json --noEmit",
    "check:capabilities": "node ../scripts/generate-real-ui-capability-matrix.mjs --manifest frontend/tests/real-integration/capabilities.json",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:e2e:incident-devops": "playwright test --config tests/e2e/incident-devops.playwright.config.ts incident-workspace.spec.ts devops-workspace.spec.ts",
    "test:e2e:stable": "playwright test tests/e2e/baseline-readonly.spec.ts",
    "test:e2e:update": "playwright test --update-snapshots"
  },
  "dependencies": {
    "@iconify-json/lucide": "1.2.120",
    "@nuxt/ui": "4.10.0",
    "@tanstack/vue-virtual": "3.13.35",
    "axios": "^1.15.2",
    "lucide-vue-next": "^0.577.0",
    "marked": "17.0.6",
    "pinia": "^3.0.4",
    "three": "0.185.1",
    "uplot": "1.6.32",
    "vue": "^3.5.22",
    "vue-router": "^4.6.4"
  },
  "devDependencies": {
    "@playwright/test": "1.61.1",
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "^20.19.43",
    "@types/three": "^0.185.1",
    "@typescript-eslint/eslint-plugin": "^7.18.0",
    "@typescript-eslint/parser": "^7.18.0",
    "@vitejs/plugin-vue": "^6.0.1",
    "eslint": "^8.57.1",
    "eslint-plugin-vue": "^9.33.0",
    "tailwindcss": "4.3.3",
    "typescript": "^5.9.3",
    "vite": "^7.1.7",
    "vitest": "^3.2.4",
    "vue-tsc": "^3.1.1"
  },
  "overrides": {
    "brace-expansion": "5.0.9",
    "fontless": {
      "esbuild": "0.28.1"
    },
    "postcss": "8.5.23"
  }
}
