{
  "name": "cloudops-workbench",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit && vite build",
    "preview": "vite preview",
    "lint": "eslint . --ext .ts,.vue",
    "lint:no-new-warnings": "eslint . --ext .ts,.vue --max-warnings 2608",
    "typecheck": "vue-tsc --noEmit",
    "typecheck:e2e": "tsc -p tsconfig.e2e.json --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:e2e:stable": "playwright test tests/e2e/baseline-readonly.spec.ts",
    "test:e2e:update": "playwright test --update-snapshots"
  },
  "dependencies": {
    "axios": "^1.15.2",
    "element-plus": "^2.14.0",
    "lucide-vue-next": "^0.577.0",
    "pinia": "^3.0.4",
    "three": "^0.185.1",
    "vue": "^3.5.22",
    "vue-router": "^4.6.4"
  },
  "devDependencies": {
    "@playwright/test": "1.61.1",
    "@types/node": "^20.19.43",
    "@types/three": "^0.185.1",
    "@typescript-eslint/eslint-plugin": "^7.18.0",
    "@typescript-eslint/parser": "^7.18.0",
    "@vitejs/plugin-vue": "^6.0.1",
    "eslint": "^8.57.1",
    "eslint-plugin-vue": "^9.33.0",
    "sass": "^1.99.0",
    "typescript": "^5.9.3",
    "vite": "^7.1.7",
    "vitest": "^3.2.4",
    "vue-tsc": "^3.1.1"
  },
  "overrides": {
    "brace-expansion": "5.0.8",
    "postcss": "8.5.23"
  }
}
